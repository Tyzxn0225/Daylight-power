struct FMemory{const TCHAR* Name;FVector Position;const TCHAR* Title;const TCHAR* Body;const TCHAR* Voice;const TCHAR* Thought;};
static const FMemory Memories[]={
{TEXT("饭桌上没有递出的便条"),FVector(-3570.000,1610.000,19.000),TEXT("家里留的位置"),TEXT("一只带盖的碗，一张写到一半的便条：‘等忙完这阵……’\n\n纸背是工时抵押单。林禾划掉了替她签名的一栏。她并没有划掉哥哥的座位。\n\n这段日常不提供额度，也不能替她表示原谅。"),TEXT("EV_Explore_001"),TEXT("林照：以前我总说，等忙完这阵。可家里等的，从来不是一个修好的世界。")},
{TEXT("旧操场的影子刻度"),FVector(-5030.000,580.000,3.000),TEXT("不会自己移动的影子"),TEXT("墙脚保留了九点、十二点、十五点的影子刻度。如今上方只有一盏按次计费的共用灯。\n\n最后一条刻痕旁写着：今天别站到妹妹的影子里。名字已经磨掉了。"),TEXT("EV_Explore_002"),TEXT("林照：那时候，影子是跟着人走的。现在，人得跟着灯走。")},
{TEXT("双费率检定原单"),FVector(-2980.000,-3480.000,3.000),TEXT("仪表合格，两种价格"),TEXT("同一型号的检定单：保障地址享有封顶年费，候补地址承担逐时浮价和断供恢复费。\n\n差价没有流向更好的灯，而被列入‘风险与履约管理’。\n\n原单只证明差别存在；它不会自动重新分配任何人的额度。"),TEXT("EV_Explore_003"),TEXT("林照：同一台表，两种价格。维修手册里，没有教过我该修哪一种。")},
{TEXT("旧日放映机与观影留言"),FVector(-3970.000,-3460.000,19.000),TEXT("有人曾抱怨夏天太长"),TEXT("停电后，放映员把旧观众的留言夹在卷轴盒中：‘下午太阳太大，等阴一点再走。’\n\n背面是放映间本月的照明申请，盖着‘非必要公共服务’。卷轴没有被卖掉。"),TEXT("EV_Explore_004"),TEXT("林照：他们还能嫌天太亮。听起来，像一句编出来的话。")},
{TEXT("共光露台上的分摊本"),FVector(-2600.000,-3470.000,300.000),TEXT("互助也需要共同签字"),TEXT("露台灯接着六户的线路。前五户按过手印，第六户的一格只有‘先帮她垫着’。\n\n旁边压着抗议便条：别因为我们是邻居，就替我答应。\n\n这根线既可能是互助，也可能是更小的垄断。你留下的是问题，没有擅自改线。"),TEXT("EV_Explore_005"),TEXT("林照：这根线接的是谁家的额度？我不问清楚，就不能说这是互助。")},
{TEXT("厨房后门的维修插销"),FVector(-4650.000,1330.000,19.000),TEXT("留给送货人的一扇门"),TEXT("厨房后门被松动的插销卡住。复位后，厨房与公共院落之间多了一条可通过的门道。\n\n这是实际打开的空间捷径，不增加供光额度，也不要求收集其他彩蛋。"),TEXT("EV_Explore_006"),TEXT("林照：后门能通到厨房。下次送零件，不用绕着站外走了。")},
};
