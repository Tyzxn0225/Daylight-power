static const FStoryLine StoryLines[]={
    {TEXT("P00"),TEXT("林禾：哥，你还记得真正的太阳吗？"),TEXT("EV_Story_001"),17,6.f,TEXT(""),TEXT(""),0,false},
    {TEXT("P00"),TEXT("林照：记得。那时候，影子会自己挪地方。"),TEXT("EV_Story_002"),18,6.f,TEXT(""),TEXT(""),0,false},
    {TEXT("P00"),TEXT("旁白：后来，太阳没有再升起来。最先消失的不是光，是等到明天的把握。"),TEXT("EV_Story_003"),2,8.f,TEXT("失光以后"),TEXT("应急照明 → 付费订阅\n临时措施没有结束日期"),0,false},
    {TEXT("P00"),TEXT("旁白：应急供光变成订阅。窗外的明亮，开始按地址、余额和担保关系分配。"),TEXT("EV_Story_004"),3,8.f,TEXT("白昼服务 / 续期须知"),TEXT("地址认证 / 余额核验 / 有效担保\n窗外的光，不包含在房租里"),0,false},
    {TEXT("P00"),TEXT("林照：八年前，我把家里的供光额度，换成了一份检修工作。"),TEXT("EV_Story_005"),4,7.f,TEXT("家庭供光转出凭证"),TEXT("转出：家庭照明额度\n转入：检修工位保证金"),0,false},
    {TEXT("P00"),TEXT("林照：合同写着自愿。那时候，别的选项也在纸上。没有一个能让我们吃饭。"),TEXT("EV_Story_006"),5,8.f,TEXT("申请人声明"),TEXT("本人自愿承担停止家庭供光的后果\n经办签名：林照"),0,false},
    {TEXT("P00"),TEXT("林照：修好一盏灯，我就多一张工单。家里的人，却多等我一个晚上。"),TEXT("EV_District_001"),23,7.f,TEXT("林照 / 社区维修工"),TEXT("29 岁 · 家庭供光曾换作工位保证金\n想要回家，也不甘心只修好别人的窗"),0,false,-1,-1},
    {TEXT("P00"),TEXT("叶岑：林照，你替家里着急，我明白。可我的检修组，也有人等着拿这份工钱回家。"),TEXT("EV_District_002"),24,7.f,TEXT("叶岑 / 工程师与检修领班"),TEXT("工作上的盟友，也是工位与工资的把关人\n她要保住自己的检修组"),0,false,-1,-1},
    {TEXT("P00"),TEXT("周驰：我是周驰。缺的零件，我能找。你欠谁的钱，我也会记着。别急着说我是好人。"),TEXT("EV_District_003"),25,7.f,TEXT("周驰 / 耗材经纪与垫款人"),TEXT("零件、饭票和担保关系都经过他的账本\n能帮你，也向你的困难收取代价"),0,false,-1,-1},
    {TEXT("P00"),TEXT("林禾：我是你妹妹，不是你每一张申请表上，替自己解释的理由。"),TEXT("EV_District_004"),10,7.f,TEXT("林禾 / 林照的妹妹"),TEXT("19 岁 · 家庭成员，也是独立的申请人\n她要求参与决定，保留说不要的权利"),0,false,-1,-1},
    {TEXT("P00"),TEXT("林照：我想让她过得好一点。只是后来，连好一点是什么，都只有我在说。"),TEXT("EV_District_005"),11,7.f,TEXT("他们之间"),TEXT("亲情不能自动换成代签\n互相依赖，也互相亏欠"),0,false,-1,-1},
    {TEXT("P00"),TEXT("林禾：你每次都说，先熬过这个月。后来，我们就不再问下个月了。"),TEXT("EV_Story_007"),10,7.f,TEXT(""),TEXT(""),0,false},
    {TEXT("P00"),TEXT("林照：这次，我想把那扇窗重新点亮。"),TEXT("EV_Story_008"),11,5.f,TEXT(""),TEXT(""),0,false},
    {TEXT("P00"),TEXT("林禾：那就先听听，住在窗后面的人怎么说。"),TEXT("EV_Story_009"),12,7.f,TEXT("白昼产权"),TEXT("不是每一次照顾，都问过被照顾的人"),0,false},
    {TEXT("C08"),TEXT("林禾：名单上有我的名字。怎么没有我的签字？"),TEXT("EV_Story_010"),10,6.f,TEXT("暂定配给 / 原始名单"),TEXT("林禾：优先列入\n申请人签名：________"),0,false},
