inline const SealText& SealForSite(int SiteIndex,int Column){return SealSheets[SiteIndex==7?1:SiteIndex==9?2:SiteIndex==13?3:0][Column];}
inline const TCHAR* Mechanic(StationSurvey::Kind K)
{
    switch(K){case StationSurvey::Kind::Align:return TEXT("透光套准");case StationSurvey::Kind::Pulse:return TEXT("脉冲寻声");case StationSurvey::Kind::Flow:return TEXT("余热复算");default:return TEXT("封签查验");}
